{
  "extends": "../../tsconfig.services.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@proyecto/shared-core": ["../../packages/shared-core/dist"],
      "@proyecto/shared-core/*": ["../../packages/shared-core/dist/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
