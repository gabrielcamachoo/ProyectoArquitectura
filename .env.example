NODE_ENV=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=proyecto
DATABASE_URL=postgresql://postgres@postgres:5432/proyecto
DATABASE_READ_URL=postgresql://postgres@postgres-replica:5432/proyecto
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672
JWT_PRIVATE_KEY=<rsa-private-key-pem>
JWT_PUBLIC_KEY=<rsa-public-key-pem>
AWS_REGION=us-east-1
S3_BUCKET=academic-materials
CLOUDFRONT_DOMAIN=example.cloudfront.net
TLS_MIN_VERSION=TLSv1.3
