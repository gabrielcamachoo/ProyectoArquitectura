{
  "name": "proyectoarquitectura",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@proyecto/shared-core",
    "build:services": "npm run build --workspaces --if-present --exclude-workspace=@proyecto/shared-core --exclude-workspace=frontend",
    "clean": "npm run clean --workspaces --if-present",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "kong:build": "node scripts/build-kong-config.mjs",
    "kong:setup": "node scripts/generate-jwt-keys.mjs && node scripts/build-kong-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
