{
  "name": "@proyecto/shared-core",
  "version": "1.0.0",
  "description": "Shared library for ProyectoArquitectura microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "require": "./dist/auth/index.js",
      "import": "./dist/auth/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "require": "./dist/http/index.js",
      "import": "./dist/http/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "require": "./dist/logging/index.js",
      "import": "./dist/logging/index.js"
    },
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "require": "./dist/repository/index.js",
      "import": "./dist/repository/index.js"
    },
    "./swagger": {
      "types": "./dist/swagger/index.d.ts",
      "require": "./dist/swagger/index.js",
      "import": "./dist/swagger/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"const fs=require('fs'); try{fs.rmSync('dist',{recursive:true,force:true});}catch(e){}\"",
    "test": "jest --passWithNoTests",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "typeorm": "^0.3.20",
    "reflect-metadata": "^0.2.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
